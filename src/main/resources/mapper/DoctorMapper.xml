    <!-- ... existing code ... -->
    <select id="listDoctorsByDoctorIdsAndStatusAndMaxAdvanceDays" resultType="com.yirancrazy.smartmedical.pojo.Doctor">
        SELECT DISTINCT d.* FROM doctor d
        WHERE d.id IN
        <foreach item="item" index="index" collection="doctorIds" separator="," open="(" close=")">
            #{item}
        </foreach>
        AND EXISTS (
        SELECT 1 FROM registration_schedule_template rst
        WHERE rst.doctor_id = d.id
        AND rst.registration_date &gt;= CURDATE()
        AND rst.registration_date &lt;= DATE_ADD(CURDATE(), INTERVAL #{maxAdvanceDays} DAY)
        AND rst.status = #{status}
        )
        ORDER BY d.id ASC
    </select>
