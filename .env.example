# Smart Medical 环境变量样例
# 复制为 .env 并填写真实值；.env 已加入 .gitignore，禁止入库。

# JWT 签名密钥（HS256，至少 32 字节；生产请用随机生成）
JWT_ACCESS_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# MinIO 访问凭证
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# MySQL 数据库凭据（dev 默认 root，prod 必须显式覆盖）
MYSQL_USERNAME=root
MYSQL_PASSWORD=

# Cookie 安全标记（dev=false；prod=true 仅 HTTPS 环境下使用）
# COOKIE_SECURE=false