# Smart Medical 环境变量样例

# 暴露端口
SERVER_PORT=8080

## 前端暴露端口（admin / user）
ADMIN_PORT=5173
USER_PORT=5174

## JWT 签名密钥（样例，部署时请替换为随机强密钥）
JWT_ACCESS_SECRET_KEY=your_access_secret_key_placeholder
JWT_REFRESH_SECRET_KEY=your_refresh_secret_key_placeholder
JWT_ACCESS_TOKEN_PREFIX=admin-access-token
JWT_REFRESH_TOKEN_PREFIX=admin-refresh-token

## MinIO 访问凭证
MINIO_HOST=localdev
MINIO_PORT=9000
## 浏览器可达地址，用于拼图片外链
MINIO_PUBLIC_HOST=127.0.0.1
MINIO_CONSOLE_PORT=9001
## MinIO 镜像版本（避免 latest 不可复现）
MINIO_IMAGE_TAG=RELEASE.2025-04-22T22-12-26Z
MINIO_BUCKET_NAME=smart-medical
## MinIO 访问凭证（新版变量名；后端客户端与 MinIO 服务端容器共用同一对）
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

## MySQL 数据库凭据
MYSQL_HOST=localdev
MYSQL_PORT=3306
MYSQL_USERNAME=your_username
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_medical


## Redis 连接配置
REDIS_HOST=localdev
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2000ms

## Cookie 安全标记（dev=false；prod=true 仅 HTTPS 环境下使用）
COOKIE_SECURE=false

## Spug 短信模板编码（注册验证码调用凭证；留空则后端 mock 模式，验证码打印到日志）
SMS_TEMPLATE_CODE=

## Spug 短信服务 base url（默认官方地址）
SMS_BASE_URL=https://push.spug.cc/sms/

## 运行时激活的 profile（dev / prod）
SPRING_PROFILES_ACTIVE=dev

## 容器时区
TZ=Asia/Shanghai

## MinIO 图片 / 文件上传大小限制（单位：m）
MINIO_IMG_SIZE=10
MINIO_FILE_SIZE=10